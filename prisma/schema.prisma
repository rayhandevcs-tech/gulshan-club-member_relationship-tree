generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Flat member record — mirrors src/lib/types.ts `Member` 1:1 ────────────
model Member {
  id            String  @id
  name          String
  type          String?
  via           String
  gender        String?
  since         String?
  pid           String?
  rel           String?
  fatherId      String?
  motherId      String?
  succession    String?
  photoUrl      String?
  note          String?

  phone         String?
  phoneRes      String?
  phoneOff      String?
  email         String?
  birthDate     String?
  memberId      String?
  membershipRef String?
  quotaNote     String?
  fatherName    String?
  motherName    String?
  father        String?
  mother        String?
}
